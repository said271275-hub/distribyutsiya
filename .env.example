# Local development only. Replace these values before any deployment.
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_HSTS_SECONDS=0
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
# Production must set SMS_PROVIDER_CLASS to an importable SMSProvider adapter.

POSTGRES_DB=distribyutsiya
POSTGRES_USER=distribyutsiya
POSTGRES_PASSWORD=local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local development only. Replace these values before any deployment.
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_HSTS_SECONDS=0
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
OTP_PROVIDER=apps.accounts.sms.DevOtpProvider
DEV_OTP_ENABLED=False
DEV_OTP_CODE=123456
# Production must switch OTP_PROVIDER to an EskizOtpProvider adapter.

# Routing: the public OSRM demo is for local development only.
ROUTING_EXTERNAL_ENABLED=True
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=5
ROUTE_START_TIME=08:00
ETA_WINDOW_MINUTES=45
TRIP_CLUSTER_RADIUS_KM=8

POSTGRES_DB=distribyutsiya
POSTGRES_USER=distribyutsiya
POSTGRES_PASSWORD=local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

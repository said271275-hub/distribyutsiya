[Unit]
Description=Distribyutsiya akkauntlarni kunlik tozalash
After=network.target postgresql.service

[Service]
Type=oneshot
User=distribyutsiya
Group=www-data
WorkingDirectory=/srv/distribyutsiya/backend
EnvironmentFile=/etc/distribyutsiya/production.env
ExecStart=/srv/distribyutsiya/venv/bin/python manage.py process_account_deletions
ExecStart=/srv/distribyutsiya/venv/bin/python manage.py cleanup_auth_records
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
